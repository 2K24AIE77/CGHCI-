    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "\n",
        "# TODO 1: Calculate Gx, Gy, and edge strength\n",
        "def sobel_edge_detection(image_block: np.ndarray) -> float:\n",
        "  \"\"\"Calculate horizontal/vertical gradients and edge strength.\"\"\"\n",
        "  sobel_gx = np.array([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]], dtype=np.float32)\n",
        "\n",
        "  sobel_gy = np.array([[-1, -2, -1], [0, 0, 0], [1, 2, 1]], dtype=np.float32)\n",
        "\n",
        "  gx = np.sum(image_block * sobel_gx)\n",
        "  gy = np.sum(image_block * sobel_gy)\n",
        "\n",
        "  strength = np.sqrt(gx**2 + gy**2)\n",
        "  return float(strength)\n",
        "\n",
        "\n",
        "problem_5_input = np.array(\n",
        "    [[20, 20, 200], [20, 20, 200], [20, 20, 200]], dtype=np.float32\n",
        ")\n",
        "\n",
        "# TODO 2: Run test\n",
        "assert sobel_edge_detection(problem_5_input) == 720.0\n",
        "print(\"Problem 5 passed\")\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "# TODO 1: Use the formula from the problem description, then np.clip to stay in [out_min, out_max].\n",
        "def contrast_stretch(\n",
        "    image: np.ndarray,\n",
        "    in_min: float,\n",
        "    in_max: float,\n",
        "    out_min: float = 0.0,\n",
        "    out_max: float = 255.0,\n",
        ") -> np.ndarray:\n",
        "  \"\"\"Change image values from one range to another.\"\"\"\n",
        "  stretched = (image - in_min) / (in_max - in_min) * (\n",
        "      out_max - out_min\n",
        "  ) + out_min\n",
        "  return np.clip(stretched, out_min, out_max)\n",
        "\n",
        "\n",
        "problem_4_input = np.array([50, 100, 150], dtype=np.float32)\n",
        "\n",
        "# TODO 2: Remove the # symbols and run the given test.\n",
        "expected = np.array([0.0, 127.5, 255.0], dtype=np.float32)\n",
        "np.testing.assert_allclose(\n",
        "    contrast_stretch(problem_4_input, 50, 150), expected\n",
        ")\n",
        "print(\"Problem 4 passed\")\n"
      ],
