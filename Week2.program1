      "cell_type": "markdown",
      "source": [
        "Grayscale calculation"
      ],
      "metadata": {
        "id": "wIMGxZPYjvLO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import cv2\n",
        "\n",
        "R, G, B = 180, 120, 60\n",
        "Y = 0.299*R + 0.587*G + 0.114*B\n",
        "print(f\"Y = {Y:.1f} -> {round(Y)}\") # 131.1 -> 131\n",
        "\n",
        "# OpenCV\n",
        "pixel = np.uint8([[[60, 120, 180]]]) # OpenCV  BGR\n",
        "gray = cv2.cvtColor(pixel, cv2.COLOR_BGR2GRAY)\n",
        "print(gray[0][0]) # 131"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "EWiDcuXViMCe",
        "outputId": "5926715d-978a-4697-8b35-6cf6629180d9"
      },
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Y = 131.1 -> 131\n",
            "131\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Brightness and constrast"
      ],
      "metadata": {
        "id": "kUdnRYZ8j6oD"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "I = 100\n",
        "alpha = 1.5\n",
        "beta = -20\n",
        "O = alpha * I + beta # 150 - 20 = 130\n",
        "O = max(0, min(255, O)) # Clip\n",
        "print(O) # 130"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "gIYwKa-ejrXt",
        "outputId": "d6b042b0-9737-48fb-c304-2d795798e9d1"
      },
      "execution_count": 23,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "130.0\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Mean filter (blurring)\n",
        "blur vs sharpen kernel"
      ],
      "metadata": {
        "id": "fa83u6uik7ET"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "neighborhood = np.array([[10,20,10],\n",
        "                         [30,50,30],\n",
        "                         [10,20,10]])\n",
        "\n",
        "total = np.sum(neighborhood) # 190\n",
        "mean = total / 9\n",
        "print(f\"Sum={total}, Mean={mean:.1f}\") # 21.1\n",
        "\n",
        "# OpenCV  blur\n",
        "import cv2\n",
        "blurred = cv2.blur(neighborhood.astype(np.uint8), (3,3))\n",
        "print(blurred[1,1]) # 21"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "zhnQ6OmCk54M",
        "outputId": "c0e1158e-c13e-4cd1-9367-c070cac09be7"
      },
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Sum=190, Mean=21.1\n",
            "21\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "\n",
        "# 1. Image load karein (agar file na ho toh auto-sample image ban jayegi)\n",
        "image = cv2.imread('input.jpg', 0)\n",
        "\n",
        "if image is None:\n",
        "  # Agar input.jpg nahi mili toh 100x100 ki random test image auto-generate karein\n",
        "  print(\"Note: 'input.jpg' nahi mili, test image generate ki ja rahi hai...\")\n",
        "  image = np.random.randint(0, 256, (100, 100), dtype=np.uint8)\n",
        "\n",
        "# 2. Blur Kernel (3x3 Mean Filter)\n",
        "blur_kernel = np.ones((3, 3), dtype=np.float32) / 9.0\n",
        "\n",
        "# 3. Sharpen Kernel\n",
        "sharpen_kernel = np.array(\n",
        "    [[0, -1, 0], [-1, 5, -1], [0, -1, 0]], dtype=np.float32\n",
        ")\n",
        "\n",
        "# 4. Filters apply karein\n",
        "blurred = cv2.filter2D(image, -1, blur_kernel)\n",
        "\n",
        "sharpened = cv2.filter2D(image, -1, sharpen_kernel)\n",
        "sharpened = np.clip(sharpened, 0, 255).astype(\n",
        "    np.uint8\n",
        ")  # Pixel values ko 0-255 range mein rakhne ke liye\n",
        "\n",
        "# 5. Output images ko save karein\n",
        "cv2.imwrite('blurred_output.jpg', blurred)\n",
        "cv2.imwrite('sharpened_output.jpg', sharpened)\n",
        "\n",
        "print(\"Processing complete! Outputs saved successfully.\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "M0qeJU7JoRPh",
        "outputId": "e1d691ed-0bcd-4b9f-9b5f-d85dcb248031"
      },
      "execution_count": 25,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Note: 'input.jpg' nahi mili, test image generate ki ja rahi hai...\n",
            "Processing complete! Outputs saved successfully.\n"
          ]
        }
      ]
    },
