    {
      "cell_type": "code",
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "\n",
        "# 1. Image Load karein\n",
        "image = cv2.imread('input.jpg')\n",
        "\n",
        "# Safety check: Agar image file nahi mili toh test image generate karein\n",
        "if image is None:\n",
        "  print(\"Note: 'input.jpg' nahi mili, sample image generate ki ja rahi hai...\")\n",
        "  image = np.random.randint(0, 256, (200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "# 2. Grayscale conversion\n",
        "gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "# 3. Threshold at 128\n",
        "_, binary_mask = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY)\n",
        "\n",
        "# 4. Blur 5x5\n",
        "blurred = cv2.blur(gray, (5, 5))\n",
        "\n",
        "# 5. Output save karein\n",
        "cv2.imwrite('output_mask.jpg', binary_mask)\n",
        "cv2.imwrite('output_blur.jpg', blurred)\n",
        "\n",
        "print(\"Processing complete! 'output_mask.jpg' aur 'output_blur.jpg' save ho chuki hain.\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vPVqI3pYpYhB",
        "outputId": "78a5099b-3260-49fd-d6b1-4da076408e0b"
      },
