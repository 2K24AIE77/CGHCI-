        "# TODO 1: Calculate image memory in bytes\n",
        "def calculate_image_memory(width: int, height: int, bpp: int) -> float:\n",
        "  \"\"\"Calculate memory in bytes for an uncompressed image.\"\"\"\n",
        "  return (width * height * bpp) / 8.0\n",
        "\n",
        "\n",
        "# TODO 2: Run test\n",
